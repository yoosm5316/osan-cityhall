# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 GitHub 에 올라가지 않습니다)

# Supabase - 프로젝트 설정 > API
SUPABASE_URL=https://your-project.supabase.co
# 공개 키 (publishable / anon). 챗봇 검색(읽기 전용)에 사용 - Vercel 에도 등록
SUPABASE_ANON_KEY=
# 관리자 키 (secret / service_role). 청크 저장(npm run ingest)에만 사용 - Vercel 에는 등록하지 마세요
SUPABASE_SERVICE_ROLE_KEY=

# Upstage 콘솔 > API Keys (임베딩: embedding-passage / embedding-query)
UPSTAGE_API_KEY=

# OpenAI 플랫폼 > API keys (답변 모델: gpt-5-mini)
OPENAI_API_KEY=
